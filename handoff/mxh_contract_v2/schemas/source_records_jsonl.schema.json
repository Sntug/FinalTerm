      "type": "string",
      "const": "2.0.0"
    },
    "source_record_id": {
      "type": "string"
    },
    "paper_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "type": "string"
    },
    "source_kind": {
      "type": "string"
    },
    "source_id": {
      "type": "string"
    },
    "source_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "url": {
      "type": "string"
    },
    "fetched_at": {
      "type": "string"
    },
    "http_status": {
      "type": "integer",
      "minimum": 0
    },
    "content_sha256": {
      "type": "string"
    },
    "content_type": {
      "type": "string"
    },
    "etag": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_modified": {
      "type": [
        "string",
        "null"
      ]
